---
/**
 * Tombol WhatsApp yang selalu menempel di layar.
 *
 * Ini komponen paling menentukan di seluruh situs. Sebagian besar pengunjung
 * datang dari HP, membaca sebentar, lalu ingin langsung bertanya. Kalau mereka
 * harus menggulir mencari nomor, sebagian besar batal.
 *
 * Di HP tombol dibuat melebar penuh di bawah layar, karena di lebar segitu tombol
 * bulat kecil sering meleset saat ditekan.
 */
import { BISNIS } from '../data/bisnis';
import { linkWA, TELEPON_HREF } from '../lib/wa';

const wa = linkWA(`Halo ${BISNIS.nama}, saya ingin bertanya soal layanan Anda.`);
---

<div class="fixed inset-x-0 bottom-0 z-50 sm:inset-x-auto sm:bottom-6 sm:right-6">
  <div class="flex gap-2 border-t border-wje-100 bg-white p-3 shadow-lg sm:flex-col sm:border-0 sm:bg-transparent sm:p-0 sm:shadow-none">
    <a
      href={TELEPON_HREF}
      data-wa="telepon-melayang"
      class="flex flex-1 items-center justify-center gap-2 rounded-xl border-2 border-wje-950 px-4 py-3.5 text-sm font-bold text-wje-950 sm:hidden"
    >
      Telepon
    </a>
    <a
      href={wa}
      target="_blank"
      rel="noopener"
      data-wa="melayang"
      class="flex flex-[2] items-center justify-center gap-2 rounded-xl bg-wa-600 px-5 py-3.5 text-sm font-bold text-white shadow-lg hover:bg-wa-600/90 sm:flex-none sm:px-6"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.174.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 0 1 6.988 2.896 9.82 9.82 0 0 1 2.893 6.994c-.003 5.45-4.437 9.886-9.885 9.886m8.413-18.297A11.82 11.82 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.88 11.88 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 0 0-3.48-8.413"
        ></path>
      </svg>
      <span class="sm:hidden">Chat WhatsApp</span>
      <span class="hidden sm:inline">WhatsApp Kami</span>
    </a>
  </div>
</div>

<!-- Ruang kosong supaya tombol yang menempel tidak menutupi bagian akhir halaman di HP. -->
<div class="h-20 sm:hidden" aria-hidden="true"></div>
