---
/**
 * Testimoni pelanggan. Tidak ditampilkan selama daftarnya kosong.
 *
 * Tidak memasang schema AggregateRating di sini. Bintang di hasil pencarian hanya
 * boleh muncul dari ulasan yang benar-benar ada, dan ulasan Google Business
 * Profile sudah menanganinya. Memasang rating sendiri di situs tanpa dasar adalah
 * pelanggaran pedoman Google.
 */
import type { Testimoni } from '../data/testimoni';

type Props = { daftar: Testimoni[]; judul?: string };
const { daftar, judul = 'Kata Pelanggan Kami' } = Astro.props;
---

{
  daftar.length > 0 && (
    <section class="bg-wje-50 py-14">
      <div class="mx-auto max-w-5xl px-4">
        <h2 class="mb-6 text-2xl font-bold text-wje-950 sm:text-3xl">{judul}</h2>
        <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {daftar.map((t) => (
            <li class="rounded-xl border border-wje-100 bg-white p-5">
              <p class="leading-relaxed text-wje-800">&ldquo;{t.isi}&rdquo;</p>
              <p class="mt-4 text-sm font-semibold text-wje-950">{t.nama}</p>
              <p class="text-sm text-wje-600">
                {t.dari} · {t.kota}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
