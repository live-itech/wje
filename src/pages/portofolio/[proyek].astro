---
/**
 * Halaman per proyek.
 *
 * Setiap proyek baru yang diterbitkan menambah satu halaman berisi foto asli dan
 * menambah tautan menuju halaman uang terkait. Ini cara paling murah menambah
 * kekuatan situs setiap bulan: satu proyek selesai, satu halaman baru.
 *
 * Selama PORTOFOLIO kosong, tidak ada halaman yang dihasilkan di sini.
 */
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Remah from '../../components/Remah.astro';
import CTAPenutup from '../../components/CTAPenutup.astro';
import { PORTOFOLIO } from '../../data/portofolio';
import { layananBySlug, PAYUNG_LABEL } from '../../data/layanan';
import { BISNIS } from '../../data/bisnis';
import { linkWA } from '../../lib/wa';
import { schemaRemah } from '../../lib/schema';

export const getStaticPaths = (() =>
  PORTOFOLIO.map((p) => ({ params: { proyek: p.slug }, props: { p } }))) satisfies GetStaticPaths;

const { p } = Astro.props;

const berkas = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/portofolio/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const foto = p.foto
  .map((f) => berkas[`../../assets/portofolio/${f}`]?.default)
  .filter((x) => x !== undefined);

const terkait = p.layananTerkait.map((s) => layananBySlug(s)).filter((x) => x !== undefined);

const jalur = [
  { nama: 'Beranda', url: '/' },
  { nama: 'Portofolio', url: '/portofolio/' },
  { nama: p.judul, url: `/portofolio/${p.slug}/` },
];
---

<BaseLayout
  title={`${p.judul} | CV WJE`.slice(0, 60)}
  deskripsi={`${p.ringkas} Dikerjakan CV Wahyu Jaya Elektrik di ${p.lokasi}, ${p.tahun}.`.slice(0, 155)}
  path={`/portofolio/${p.slug}/`}
  skema={[schemaRemah(jalur)]}
>
  <Remah jalur={jalur} />

  <article class="mx-auto max-w-3xl px-4 pb-10 pt-12">
    <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-aksen-600">
      {PAYUNG_LABEL[p.payung]}
    </p>
    <h1 class="text-3xl font-extrabold tracking-tight text-wje-950 sm:text-4xl">{p.judul}</h1>
    <p class="mt-3 text-wje-600">{p.spesifikasi} · {p.lokasi} · {p.tahun}</p>
    <p class="mt-5 text-lg leading-relaxed text-wje-800">{p.ringkas}</p>

    <div class="mt-8 space-y-5">
      {
        foto.map((g, i) => (
          <Image
            src={g!}
            alt={`${p.judul} di ${p.lokasi}, foto ${i + 1}`}
            widths={[640, 1024]}
            sizes="(max-width: 768px) 100vw, 768px"
            class="w-full rounded-xl"
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        ))
      }
    </div>

    {
      terkait.length > 0 && (
        <div class="mt-10 rounded-xl border border-wje-100 bg-wje-50 p-6">
          <h2 class="mb-3 text-lg font-bold text-wje-950">Layanan Terkait</h2>
          <ul class="space-y-2">
            {terkait.map((t) => (
              <li>
                <a
                  href={`/${t.slug}/`}
                  class="font-medium text-aksen-600 underline underline-offset-4 hover:text-aksen-500"
                >
                  {t.h1.split('—')[0].trim()}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </article>

  <CTAPenutup
    hrefWA={linkWA(`Halo ${BISNIS.nama}, saya melihat proyek "${p.judul}" di website Anda dan ingin bertanya.`)}
    judul="Butuh pekerjaan serupa?"
    posisi="penutup-proyek"
  />
</BaseLayout>
