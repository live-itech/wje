---
/** Daftar artikel. Mencegah ada artikel yang tidak punya tautan masuk sama sekali. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Remah from '../../components/Remah.astro';
import CTAPenutup from '../../components/CTAPenutup.astro';
import { getCollection } from 'astro:content';
import { PAYUNG_LABEL, type Payung } from '../../data/layanan';
import { BISNIS } from '../../data/bisnis';
import { linkWA } from '../../lib/wa';
import { schemaRemah } from '../../lib/schema';

const artikel = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.terbit.getTime() - a.data.terbit.getTime(),
);

const payungUrut: Payung[] = ['crane', 'lift', 'elektrik'];
const jalur = [
  { nama: 'Beranda', url: '/' },
  { nama: 'Artikel', url: '/blog/' },
];
const tanggal = new Intl.DateTimeFormat('id-ID', { dateStyle: 'long' });
---

<BaseLayout
  title="Artikel Teknis Crane, Lift Barang & Listrik | CV WJE"
  deskripsi="Panduan praktis seputar hoist crane, lift barang, dan kelistrikan industri, ditulis dari pengalaman lapangan di Surabaya dan sekitarnya."
  path="/blog/"
  skema={[schemaRemah(jalur)]}
>
  <Remah jalur={jalur} />

  <section class="mx-auto max-w-5xl px-4 pb-6 pt-12">
    <h1 class="text-3xl font-extrabold tracking-tight text-wje-950 sm:text-4xl">
      Artikel dan Panduan Teknis
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-wje-800">
      Ditulis dari pekerjaan yang benar-benar kami kerjakan di lapangan, bukan salinan dari
      tempat lain. Kalau ada yang ingin ditanyakan setelah membaca, silakan langsung WhatsApp.
    </p>
  </section>

  {
    artikel.length === 0 ? (
      <section class="mx-auto max-w-5xl px-4 py-10">
        <p class="rounded-xl border border-wje-100 bg-wje-50 p-6 text-wje-600">
          Artikel pertama akan terbit sesuai jadwal mingguan. Sementara itu, silakan lihat
          <a href="/portofolio/" class="font-semibold text-aksen-600 underline">portofolio</a> kami.
        </p>
      </section>
    ) : (
      payungUrut.map((p) => {
        const grup = artikel.filter((a) => a.data.payung === p);
        return (
          grup.length > 0 && (
            <section class="mx-auto max-w-5xl px-4 py-8">
              <h2 class="mb-5 text-xl font-bold text-wje-950">{PAYUNG_LABEL[p]}</h2>
              <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {grup.map((a) => (
                  <li>
                    <a
                      href={`/blog/${a.id}/`}
                      class="block h-full rounded-xl border border-wje-100 p-5 transition hover:border-aksen-400 hover:bg-wje-50"
                    >
                      <h3 class="font-semibold leading-snug text-wje-950">{a.data.judul}</h3>
                      <p class="mt-2 text-sm text-wje-600">{a.data.ringkas}</p>
                      <p class="mt-3 text-xs text-wje-600">{tanggal.format(a.data.terbit)}</p>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        );
      })
    )
  }

  <CTAPenutup
    hrefWA={linkWA(`Halo ${BISNIS.nama}, saya ingin bertanya soal layanan Anda.`)}
    posisi="penutup-blog"
  />
</BaseLayout>
